# The deployed web app the mobile client calls. On the iOS simulator localhost is the host
# machine; on a physical device use your machine's LAN address or a deployed URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3100

# Same Supabase project as the web app. Public by design in a native binary: the anon key
# grants nothing without RLS-passing credentials. NEVER put the service role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
