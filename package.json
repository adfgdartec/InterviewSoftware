{
  "name": "loopcraft",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "_lint_comment": "`eslint .` from the root, NOT `turbo run lint`. Turbo only ran the lint task in the two packages that declare one, so scripts/ was never linted and a no-undef error there failed CI while `pnpm lint` passed locally. CI runs `pnpm exec eslint .`; this runs the same thing.",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:rls": "pnpm --filter @loopcraft/db test:rls",
    "db:migrate": "DATABASE_URL=postgres://loopcraft:loopcraft_local_dev@localhost:54329/loopcraft pnpm --filter @loopcraft/db migrate",
    "db:init": "./scripts/pg.sh init",
    "db:start": "./scripts/pg.sh start",
    "db:stop": "./scripts/pg.sh stop",
    "db:status": "./scripts/pg.sh status",
    "dev:web": "pnpm --filter @loopcraft/web dev",
    "dev:worker": "apps/worker/.venv/bin/uvicorn loopcraft_worker.app:app --app-dir apps/worker --port 8099",
    "db:seed": "DATABASE_URL=postgres://loopcraft:loopcraft_local_dev@localhost:54329/loopcraft pnpm --filter @loopcraft/db db:seed",
    "preflight": "node scripts/preflight.mjs --env-file apps/web/.env.local"
  },
  "devDependencies": {
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/node": "22.18.9",
    "eslint": "9.39.1",
    "typescript-eslint": "8.46.4",
    "@eslint/js": "9.39.1",
    "eslint-plugin-loopcraft": "workspace:*",
    "@loopcraft/core": "workspace:*"
  },
  "type": "module"
}
